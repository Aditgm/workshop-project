DATABASE_URL="postgresql://workshop:workshop@localhost:5432/workshop?schema=public"
SITE_URL="http://localhost:3000"

# Required for real payments. Without a key, checkout is simulated in development only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Required by prisma/seed.ts. Set strong values in production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional sample member account.
SEED_MEMBER_EMAIL=""
SEED_MEMBER_PASSWORD=""

# On Vercel, set DATABASE_URL to a hosted Postgres connection string.
# Use the direct/non-pooled URL so Prisma migrations can run during the build.
